APP_NAME="Golden Rastreamento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# BANCO DE DADOS
#
# DESENVOLVIMENTO / OFFLINE  -> use sqlite (padrão abaixo). Basta rodar:
#     touch database/database.sqlite && php artisan migrate --seed
#
# PRODUÇÃO (SERVIDOR)        -> troque DB_CONNECTION para mysql e preencha
#     as credenciais abaixo. As migrations são driver-agnostic (SQLite/MySQL).
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=golden_sistema
# DB_USERNAME=golden_user
# DB_PASSWORD=troque_aqui

# Arquivo, de propósito: sessão e cache não devem gerar consulta ao banco em cada
# visita. Em produção, mantenha CACHE_STORE=file (ou redis) e troque QUEUE_CONNECTION
# por database com `php artisan queue:work` sob supervisor.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------------
# E-MAIL (SMTP)
#
# Em desenvolvimento o driver é `log`: a mensagem inteira é gravada em arquivo em
# vez de enviada. Em produção troque MAIL_MAILER para `smtp` e preencha as
# credenciais do servidor — o código já está pronto, só falta a credencial.
#
# MAIL_LOG_CHANNEL é o canal de log que recebe esses e-mails (definido em
# config/logging.php, com nível debug próprio). Ele existe porque a produção roda
# com LOG_LEVEL=warning: herdando o log da aplicação, o aviso — que é gravado em
# debug — seria filtrado e não sobraria rastro nenhum do que foi enviado.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_LOG_CHANNEL=email
MAIL_HOST=smtp.goldenrastreamento.com.br
MAIL_PORT=587
MAIL_USERNAME=comercial@goldenrastreamento.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=comercial@goldenrastreamento.com.br
MAIL_FROM_NAME="Golden Rastreamento"

# === Golden Rastreamento ===
GOLDEN_WHATSAPP=5519997101483
GOLDEN_EMAIL=comercial@goldenrastreamento.com.br
GOLDEN_TRACKING_ENABLED=false
