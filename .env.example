APP_NAME="Golden Rastreamento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# BANCO DE DADOS
#
# DESENVOLVIMENTO / OFFLINE  -> use sqlite (padrão abaixo). Basta rodar:
#     touch database/database.sqlite && php artisan migrate --seed
#
# PRODUÇÃO (SERVIDOR)        -> troque DB_CONNECTION para mysql e preencha
#     as credenciais abaixo. As migrations são driver-agnostic (SQLite/MySQL).
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=golden_sistema
# DB_USERNAME=golden_user
# DB_PASSWORD=troque_aqui

# Arquivo, de propósito: sessão e cache não devem gerar consulta ao banco em cada
# visita. Em produção, mantenha CACHE_STORE=file (ou redis) e troque QUEUE_CONNECTION
# por database com `php artisan queue:work` sob supervisor.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------------
# E-MAIL (SMTP)
#
# Em desenvolvimento o driver é `log`: a mensagem inteira é gravada em arquivo em
# vez de enviada. Em produção troque MAIL_MAILER para `smtp` e preencha as
# credenciais do servidor — o código já está pronto, só falta a credencial.
#
# MAIL_LOG_CHANNEL é o canal de log que recebe esses e-mails (definido em
# config/logging.php, com nível debug próprio). Ele existe porque a produção roda
# com LOG_LEVEL=warning: herdando o log da aplicação, o aviso — que é gravado em
# debug — seria filtrado e não sobraria rastro nenhum do que foi enviado.
#
# O remetente é uma caixa de máquina, criada só para conectar e disparar
# (uapi Email add_pop), nunca o e-mail de alguém do dia a dia: assim o sistema
# não compete com correspondência real e pode ser trocado de servidor sem
# depender de pessoa nenhuma. Senha com `#` precisa de aspas, senão o `#` é
# lido como comentário e o MAIL_PASSWORD chega vazio.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_LOG_CHANNEL=email
MAIL_HOST=foco.server-golden.com.br
MAIL_PORT=587
MAIL_USERNAME=disparos@foco.server-golden.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=disparos@foco.server-golden.com.br
MAIL_FROM_NAME="Golden Rastreamento"

# === Golden Rastreamento ===
GOLDEN_WHATSAPP=5519997101483
GOLDEN_EMAIL=comercial@goldenrastreamento.com.br
GOLDEN_TRACKING_ENABLED=false

# ---------------------------------------------------------------------------
# DEPOIMENTOS DO GOOGLE BUSINESS PROFILE
#
# Traz as avaliações do perfil com a foto de quem escreveu para o carrossel do
# site (`php artisan depoimentos:google`, ou o botão "Atualizar do Google" no
# painel). As três primeiras só existem depois de o perfil estar verificado há
# mais de 60 dias e de a `Business Profile API v4` estar liberada para o projeto
# (a aprovação do Google leva dias úteis) — o conta e a unidade aparecem na URL
# do painel em business.google.com: accounts/<ID>/locations/<ID>.
#
# GOOGLE_BUSINESS_TOKEN é um Bearer de OAuth de uma conta que administra esse
# perfil (obtido com `gcloud auth application-default print-access-token`, com o
# escopo https://www.googleapis.com/auth/business.manage). Ele expira: renovado no
# servidor, nunca no repositório. Sem as três variáveis o sistema funciona e o
# importador apenas explica o que falta.
#
# GOOGLE_BUSINESS_LIMITE é quantas avaliações ler por rodada (a API entrega até 50
# por página). GOOGLE_BUSINESS_NOTA_MINIMA deixa de fora o que não é depoimento:
# avaliação de 1 ou 2 estrelas vira chamado, não vitrine.
# ---------------------------------------------------------------------------
# GOOGLE_BUSINESS_ACCOUNT=
# GOOGLE_BUSINESS_LOCATION=
# GOOGLE_BUSINESS_TOKEN=
# GOOGLE_BUSINESS_LIMITE=50
# GOOGLE_BUSINESS_NOTA_MINIMA=4
