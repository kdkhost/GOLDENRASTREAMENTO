APP_NAME="Golden Rastreamento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# BANCO DE DADOS
#
# DESENVOLVIMENTO / OFFLINE  -> use sqlite (padrão abaixo). Basta rodar:
#     touch database/database.sqlite && php artisan migrate --seed
#
# PRODUÇÃO (SERVIDOR)        -> troque DB_CONNECTION para mysql e preencha
#     as credenciais abaixo. As migrations são driver-agnostic (SQLite/MySQL).
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=golden_sistema
# DB_USERNAME=golden_user
# DB_PASSWORD=troque_aqui

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# === Golden Rastreamento ===
GOLDEN_WHATSAPP=5535988880000
GOLDEN_EMAIL=comercial@goldenrastreamento.com.br
GOLDEN_TRACKING_ENABLED=false
